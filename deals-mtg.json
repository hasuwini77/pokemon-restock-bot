{
  "_help": "MTG: alerts when a sealed Tradera Buy Now is below the lowest shop price for the same product (state-mtg.json). Items without any shop price are skipped. `schedule`: collector runs every other call.",
  "groups": {
    "collector": "magic the gathering collector booster",
    "playbox": "magic the gathering play booster display",
    "bundle": "magic the gathering bundle"
  },
  "schedule": [
    "collector",
    "playbox",
    "collector",
    "bundle"
  ],
  "items": [
    {
      "name": "Final Fantasy Collector Booster Display",
      "group": "collector",
      "match": [
        "final fantasy",
        "collector'?s? boost",
        "display|box|\\(12\\)"
      ]
    },
    {
      "name": "Final Fantasy Collector Booster",
      "group": "collector",
      "match": [
        "final fantasy",
        "^(?!.*(display|box|\\(12\\))).*collector'?s? boost"
      ]
    },
    {
      "name": "Final Fantasy Play Booster Display",
      "group": "playbox",
      "match": [
        "final fantasy",
        "play (booster )?(display|box)"
      ]
    },
    {
      "name": "Final Fantasy Gift Bundle",
      "group": "bundle",
      "match": [
        "final fantasy",
        "gift bundle|gift edition"
      ]
    },
    {
      "name": "Final Fantasy Bundle",
      "group": "bundle",
      "match": [
        "final fantasy",
        "^(?!.*gift).*bundle"
      ]
    },
